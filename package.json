{
  "name": "bootlyga",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/domain",
    "packages/gateway",
    "packages/mock-engine",
    "apps/web"
  ],
  "scripts": {
    "typecheck": "tsc -p packages/domain && tsc -p packages/gateway && tsc -p packages/mock-engine && tsc -p apps/web",
    "test": "node --import tsx --test packages/domain/test/*.test.ts packages/gateway/test/*.test.ts packages/mock-engine/test/*.test.ts",
    "build": "npm run build -w @bootlyga/web && npm run build -w @bootlyga/gateway && npm run build -w @bootlyga/mock-engine",
    "lint": "eslint .",
    "check": "make check",
    "dev:mock": "tsx packages/mock-engine/src/index.ts",
    "dev:gateway": "tsx packages/gateway/src/index.ts",
    "dev:web": "npm run dev -w @bootlyga/web",
    "smoke": "node scripts/smoke.mjs",
    "stack": "docker compose up --build"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.49.1",
    "@types/node": "^22.10.2",
    "esbuild": "^0.24.2",
    "eslint": "^9.17.0",
    "globals": "^15.15.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.2"
  }
}
